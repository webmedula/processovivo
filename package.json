{
  "name": "processovivo",
  "version": "0.67.2",
  "private": true,
  "description": "SaaS de consulta e acompanhamento de processos judiciais nos tribunais brasileiros",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "processovivo": "./dist/main/cli.js"
  },
  "main": "./dist/main/http/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/http/index.ts",
    "backup": "tsx src/main/cli.ts backup",
    "cli": "tsx --env-file-if-exists=.env src/main/cli.ts",
    "chave": "node scripts/gerar-chave.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/http/index.js",
    "start:local": "node --env-file-if-exists=.env dist/main/http/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.159",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "~4.13.0",
    "eslint": "^10.14.0",
    "globals": "^17.0.0",
    "ical.js": "^2.2.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
