# ---------------------------------------------------------------------------
# Processo Vivo — variáveis de ambiente
#
# Local:     cp .env.example .env  e ajuste
# Easypanel: cole o conteúdo (sem os comentários) na aba Environment do App
#            — lá o .env não existe; as variáveis vêm do painel.
# ---------------------------------------------------------------------------

# === HTTP ==================================================================
# 0.0.0.0 é obrigatório dentro de contêiner. Com 127.0.0.1 o serviço sobe,
# passa no log e mesmo assim fica invisível para o proxy do Easypanel.
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Chaves aceitas em `x-api-key` (ou `Authorization: Bearer`), separadas por
# vírgula. Uma por cliente/integração, para poder revogar uma sem derrubar as
# outras.
#
#   npm run chave              gera uma (funciona em Windows, sem openssl)
#   npm run chave -- 3 --env   gera três já no formato desta linha
#
# SEM ESTA VARIÁVEL O SERVIÇO SE RECUSA A SUBIR, e chave com menos de 24
# caracteres também é recusada. É proposital: chave fraca é pior do que
# nenhuma, porque passa a sensação de proteção.
PROCESSOVIVO_API_KEYS=

# Escape explícito para rodar sem autenticação. Use APENAS quando o serviço não
# tiver domínio público e só for acessado pela rede interna do Easypanel.
PROCESSOVIVO_AUTH_DISABLED=false

# Limite por chave de API (ou por IP, quando sem autenticação).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Atrás do Traefik do Easypanel. Sem isso, todo request parece vir do IP do
# proxy e o rate limit por IP vira um limite global compartilhado.
HTTP_TRUST_PROXY=true

# Origens liberadas para CORS, separadas por vírgula. Vazio = CORS desligado
# (correto para API consumida por servidor; preencha se um front no navegador
# for chamar direto).
CORS_ORIGINS=

# === Fontes de dados =======================================================
# Ordem da cadeia: o primeiro é o primário, os seguintes são fallback — e, a
# partir da v0.9.0, as fontes seguintes também COMPLEMENTAM o que a primeira não
# soube responder.
# Valores aceitos: datajud, djen, mock-crawler-tjsp
#
# Por que nesta ordem: só o DataJud tem a linha do tempo completa e a data de
# distribuição; o DJEN entra atrás e acrescenta partes, advogados e o inteiro
# teor. Invertendo, um processo com 361 andamentos apareceria com 8.
PROCESSOVIVO_PROVIDER_CHAIN=datajud,djen

# --- DataJud (CNJ) ---------------------------------------------------------
# Chave Pública compartilhada, divulgada pelo DPJ/CNJ em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Cole APENAS a chave; o prefixo "APIKey " é adicionado pelo adapter.
# Vazia = o DataJud sai da cadeia com um aviso, e o serviço sobe assim mesmo.
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# 60s NÃO é exagero: medimos `took: 20514` (20,5s) numa consulta real por número
# em índice frio. Com 8s, toda primeira consulta falhava como se fosse rede.
DATAJUD_TIMEOUT_MS=60000
# Teto da verificação de saúde (/ready, `cli saude`). Estourar NÃO reprova a
# fonte: ela aparece como "lenta" — índice frio do CNJ, não indisponibilidade.
DATAJUD_TIMEOUT_VERIFICACAO_MS=30000
# Autolimite. A chave do CNJ é compartilhada: estourar a cota prejudica todos
# que usam a mesma chave e pode gerar bloqueio.
DATAJUD_RATE_LIMIT_PER_MINUTE=60

# --- DJEN (Diário de Justiça Eletrônico Nacional, via CNJ) -----------------
# NÃO PRECISA DE CHAVE. É o diário oficial: a base é aberta por desenho.
#
# É a única fonte do projeto que faz busca por OAB, e a única que traz partes,
# advogados e o inteiro teor dos atos. Em compensação só conhece o que foi
# PUBLICADO no diário — juntada, conclusão e expediente de cartório não
# aparecem, e o histórico começa por volta de 2023.
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
# Latência medida: 185ms a 993ms. Duas ordens de grandeza abaixo do DataJud.
DJEN_TIMEOUT_MS=20000
DJEN_RATE_LIMIT_PER_MINUTE=60
# Teto de publicações lidas numa busca por OAB. Um advogado ativo tem milhares;
# 500 cobrem vários meses, que é o que revela a carteira viva.
DJEN_MAX_COMUNICACOES_POR_OAB=500

# --- MNI: as PEÇAS do processo ---------------------------------------------
# O DJEN publica ato judicial e o DataJud não tem documento nenhum. Petição,
# contestação, laudo e documento juntado pela parte só saem pelo MNI — e só
# para quem está habilitado nos autos, com a credencial do próprio advogado.
#
# Endpoint do Projudi/TJGO. NÃO é o /intercomunicacao do PJe: nesse caminho o
# Projudi responde 404, o que já levou à conclusão errada de que o TJGO não
# tinha MNI.
MNI_ENDPOINT=https://projudi.tjgo.jus.br/IntercomunicacaoService
MNI_TRIBUNAIS=TJGO
# 90s: com incluirDocumentos o tribunal monta e transmite os PDFs na mesma
# resposta. Não se compara com os 20s que bastam ao DJEN.
MNI_TIMEOUT_MS=90000
# Metade do teto relatado (~50/min) antes de bloqueio de IP com 403 e espera de
# ~30 min. Num VPS o IP é compartilhado por todos os assinantes: estourar tira
# o acesso de todo mundo ao mesmo tempo.
MNI_RATE_LIMIT_PER_MINUTE=30
# Depois de um HTTP 403 o MNI INTEIRO fica parado por estes minutos — peça
# avulsa, régua e leitor, de todos os assinantes. O bloqueio é do IP do
# servidor; insistir durante ele só o prolonga.
MNI_PAUSA_APOS_403_MIN=30

# --- Leitor de peças (v0.30.0) ---------------------------------------------
# Junta as peças marcadas num PDF único com índice de páginas. Exige o acesso
# a peças (chave do cofre, abaixo) e o `qpdf` instalado (a imagem já traz).
#
# Pasta da guarda temporária. Vazio = `leitor/` ao lado do banco (no contêiner,
# /dados/leitor). Fica FORA do backup automático, de propósito.
LEITOR_PASTA=
# Executável do qpdf.
LEITOR_QPDF=qpdf
# Lote adaptativo: começa em 5 peças por chamada (o primeiro lote é pedido às
# cegas — a listagem não diz o tamanho de nada), sobe para 10 e 20 com resposta
# leve, cai pela metade quando a resposta passa de LEITOR_LOTE_MAX_RESPOSTA_MB.
# A conta da memória está em docs/leitor-medicoes-v0.30.0.md.
LEITOR_LOTE_INICIAL=5
LEITOR_LOTE_MAXIMO=20
LEITOR_LOTE_MAX_RESPOSTA_MB=12
LEITOR_LOTE_CRESCER_ABAIXO_MB=3
# Pausa mínima entre duas chamadas do leitor ao tribunal (soma-se ao limite
# por minuto acima, nunca o substitui).
LEITOR_PAUSA_ENTRE_CHAMADAS_MS=3000
# Prazo de guarda do PDF combinado e cotas. Processo em segredo de justiça
# não é guardado.
LEITOR_TTL_HORAS=24
LEITOR_COTA_POR_PDF_MB=300
LEITOR_COTA_POR_WORKSPACE_MB=1024
# Uso total de disco do leitor acima disto vira aviso no log.
LEITOR_AVISO_DISCO_MB=10240
# Acima de quantas peças marcadas a tela pede confirmação antes de montar.
LEITOR_CONFIRMAR_ACIMA_DE=150

# --- Pasta digital (v0.33.0) -------------------------------------------------
# Cliques seguidos em peças dentro desta janela viram UMA consulta ao tribunal
# (a do último pedido). A guarda por peça usa a mesma pasta, o mesmo prazo e as
# mesmas cotas do leitor (LEITOR_*): o espaço da conta é um só.
PASTA_DEBOUNCE_MS=400

# Janelas das telas (v0.32.1). Atualizações: dias mostrados por padrão (a tela
# tem "Todas"). Pendência: por quantos dias um ato que pede providência conta
# como pendente — vale para o selo da carteira, o painel e a tela do processo.
NOVIDADES_JANELA_DIAS=15
PENDENCIA_JANELA_DIAS=10

# Chave que cifra a senha do advogado no tribunal (AES-256-GCM, 32 bytes em
# base64). Gere com:  npm run chave -- --cofre
#
# SEM ELA o acesso a peças não é montado e as rotas respondem 501. É de
# propósito: guardar senha de tribunal em claro transformaria um vazamento de
# banco em acesso aos processos de terceiros.
#
# Trocar esta chave torna ilegíveis as credenciais já cadastradas — cada
# assinante precisaria cadastrar a senha de novo. A linha vai VAZIA: um
# placeholder passaria em toda checagem de presença e viraria chave de mentira.
PROCESSOVIVO_CREDENCIAL_CHAVE=

# --- Mock crawler ----------------------------------------------------------
# Latência simulada e taxa de falha (0 a 1) para exercitar o fallback.
MOCK_CRAWLER_LATENCY_MS=120
MOCK_CRAWLER_FAILURE_RATE=0

# === Contas de acesso ======================================================
# O CADASTRO É ABERTO: qualquer advogado cria a conta com nome, e-mail e senha,
# e ganha um ambiente próprio. É decisão de produto — o Processo Vivo é vendido a
# advogados pelo Brasil, e convite não combina com isso.
#
# O que protege a cota compartilhada do CNJ não é o número de contas: é o rate
# limiter do NOSSO lado, por conta, dentro dos adapters.
#
# As chaves acima continuam existindo para INTEGRAÇÃO (n8n, script, CLI), que
# não tem navegador para guardar cookie. Cada chave é seu próprio ambiente, e
# revogar é tirá-la desta variável.

# === Área administrativa ===================================================
# Painel em /admin, protegido por HTTP Basic Auth — só o operador do sistema,
# nunca um assinante. De lá dá para liberar/cancelar assinatura e emitir/
# revogar chave de API sem tocar em CLI nem reiniciar o serviço.
#
# AS DUAS VAZIAS (padrão) DESLIGAM A ÁREA: /admin e /admin/api/* respondem 501
# em vez de pedir credencial — dizer "não configurado" é mais honesto que
# fingir que a rota não existe.
#
# Definir só uma das duas é erro de configuração e o serviço se recusa a
# subir. A senha precisa de pelo menos 16 caracteres — é a única credencial
# desta área, sem 2FA, então curta é o mesmo risco que reaproveitar senha de
# outro lugar.
PROCESSOVIVO_ADMIN_USUARIO=
PROCESSOVIVO_ADMIN_SENHA=
# E-mail do operador para o alerta de custo diário da IA (v0.58.0). Opcional: vazio = só o aviso na tela
# "IA" do /admin. Cai em PROCESSOVIVO_PAGAMENTO_AVISO_EMAIL se esta estiver vazia. Só sai com SMTP de verdade.
PROCESSOVIVO_ADMIN_EMAIL=

# === Vigilância por OAB ====================================================
# Cadastre a inscrição uma vez e toda publicação nova no nome do advogado entra
# sozinha na carteira. Exige "djen" na cadeia — é a única fonte que indexa
# advogado. Sem ela, as rotas /v1/vigilancias respondem 501.
#
# 1 hora, e não 12 como a varredura de processos: esta só toca o DJEN, que
# responde em 200ms e não cobra nada. É onde estão as publicações que abrem
# prazo, e cada hora de atraso é uma hora a menos para o advogado responder.
# 0 desliga a varredura automática (a manual continua valendo).
VIGILANCIA_INTERVALO_HORAS=1
VIGILANCIA_MAXIMO_POR_VARREDURA=50
VIGILANCIA_PAUSA_MS=1000

# === Aviso por e-mail ======================================================
# SEM SMTP_HOST o sistema entra em modo log: monta o resumo e escreve no log o
# que teria enviado, em vez de desligar a funcionalidade. Assim um defeito no
# resumo aparece antes do dia em que você ligar o SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true só na porta 465 (TLS direto). Em 587 o padrão é STARTTLS, negociado.
SMTP_SECURE=false
# Remetente. Vazio = usa SMTP_USER.
SMTP_FROM=
# Endereço público do sistema — ex.: https://processovivo.seudominio.com.br
#
# Sai nos links dos e-mails. SEM ELE (ou sem SMTP_HOST) a RECUPERAÇÃO DE SENHA
# não é oferecida: a tela de entrada nem mostra o "esqueci minha senha". É de
# propósito — aceitar o pedido, dizer "enviamos um e-mail" e não enviar nada é
# pior do que não ter a funcionalidade.
#
# Vem daqui, e NÃO do cabeçalho Host da requisição: senão bastaria mandar outro
# Host para o nosso servidor enviar, com a nossa cara, um link apontando para o
# endereço de quem atacou.
# Em produção: https://app.processovivo.com.br (o SUBDOMÍNIO do app, porque a
# raiz do domínio é a página de vendas). Em desenvolvimento: http://localhost:3000
PROCESSOVIVO_URL_BASE=
# Horas de silêncio antes de avisar que NÃO conseguimos verificar. Este aviso é
# tão importante quanto o de novidade: sem ele, o advogado lê silêncio como
# "não houve nada" — e o silêncio pode ser a varredura morta.
NOTIFICACAO_HORAS_ATE_ALERTAR=26

# === Cache =================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=1000

# === Banco e atualização automática ==========================================
# Arquivo SQLite com os processos acompanhados e o histórico de novidades.
# NO CONTÊINER tem que apontar para um VOLUME (/dados), senão tudo some no
# redeploy. Local, um caminho relativo resolve.
PROCESSOVIVO_DB_PATH=./dados/processovivo.db

# De quanto em quanto tempo varrer os processos acompanhados. 0 desliga.
# Cada consulta fria ao CNJ leva ~20s, então uma carteira de 100 processos leva
# meia hora de fila — por isso roda em segundo plano, e não a cada acesso.
SYNC_INTERVALO_HORAS=12
SYNC_MAXIMO_POR_VARREDURA=200
# Pausa entre consultas. A chave do CNJ é compartilhada por todo o país.
SYNC_PAUSA_MS=1500
# Quantos processos a varredura verifica AO MESMO TEMPO (1 a 4; padrão 3). Cada trabalhador respeita a pausa acima e
# os limites de requisição por fonte (DATAJUD_RATE_LIMIT_PER_MINUTE, DJEN_RATE_LIMIT_PER_MINUTE) continuam valendo
# para todos juntos. 1 volta ao comportamento de antes (um de cada vez). Valor inválido: usa 3 e avisa no log.
SYNC_CONCORRENCIA=3

# === Backup do banco =======================================================
# LIGADO por padrão, e sem linha para desligar por engano: um sistema que
# guarda a carteira e a credencial de tribunal do assinante não pode depender
# de alguém lembrar de configurar backup. 0 desliga.
#
# As cópias vão para a subpasta `backups/` ao lado do arquivo do banco — ou
# seja, DENTRO do mesmo volume. Isso protege contra apagar a tabela errada e
# contra corromper o arquivo; NÃO protege contra perder o volume. Para isso,
# leve as cópias para fora do VPS (ver DEPLOY.md, "Backup e restauração").
BACKUP_INTERVALO_HORAS=24
BACKUP_MANTER=7

# === Log ===================================================================
# debug | info | warn | error | silent
LOG_LEVEL=info

# === Análise de ato por IA (v0.38.0) =======================================
# NASCE DESLIGADA. Ligue só com PROCESSOVIVO_IA_HABILITADA=true e a chave do
# OpenRouter. Não existe variável para desligar a retenção zero de dados (ZDR):
# ela é exigida em toda chamada, e sem provedor ZDR a análise simplesmente não
# acontece. Só contas com o plano IA usam (sem exceção, nem chave de API).
PROCESSOVIVO_IA_HABILITADA=false
# (v0.50.0) A antiga PROCESSOVIVO_IA_WORKSPACES_LIBERADOS saiu: não libera mais nada e,
# se ainda estiver no painel, só gera um aviso no log. Libere o plano IA pelo /admin.
# Obrigatória SOMENTE com a IA habilitada. Deixe vazia enquanto estiver desligada.
OPENROUTER_API_KEY=
# Id de um modelo real do OpenRouter (sem "~" nem ":").
PROCESSOVIVO_IA_MODELO=deepseek/deepseek-v4-flash
# padrao | desligado | nenhum | minimo | baixo
PROCESSOVIVO_IA_RACIOCINIO=desligado
PROCESSOVIVO_IA_MAX_TOKENS=1200
PROCESSOVIVO_IA_TIMEOUT_MS=90000
# Opcional: lista (vírgula) de provedores autorizados. Vazia = todos os provedores
# ZDR do modelo. Preenchida = só os que também estiverem na lista ZDR.
PROCESSOVIVO_IA_PROVEDORES_PERMITIDOS=
# Freio por conta, em memória (reiniciar o serviço zera).
PROCESSOVIVO_IA_MAX_POR_HORA=20
PROCESSOVIVO_IA_MAX_SIMULTANEAS=3
# Teto TÉCNICO de segurança por conta e por dia (v0.50.0), contado no dia de São Paulo e em
# memória (reiniciar zera). Não é limite do plano: é o freio contra uso anômalo. Atingido, a
# tela diz "Muitas análises hoje. Tente de novo amanhã ou fale com a gente." e o modelo não é chamado.
PROCESSOVIVO_IA_MAX_POR_DIA=200
# Resumo de processo por IA (v0.40.0): freio próprio por conta (por hora, em memória), teto de
# tokens de saída e tempo limite. O resumo envia vários atos de uma vez, então custa mais.
# --- Análise de PEÇA por IA (v0.55.0) ---
# Duas chaves. Sem nenhuma delas o botão não aparece. A conta TAMBÉM precisa do plano com análise por IA.
# HABILITADA=true libera todas as contas com o plano; com false, só as contas da lista abaixo.
PROCESSOVIVO_IA_PECAS_HABILITADA=false
# Identificadores de conta (16 ou 32 caracteres hexadecimais), separados por vírgula. Veja o DEPLOY.md.
PROCESSOVIVO_IA_PECAS_WORKSPACES=
# Vazio = o modelo de PROCESSOVIVO_IA_MODELO.
PROCESSOVIVO_IA_PECAS_MODELO=
PROCESSOVIVO_IA_PECAS_MAX_POR_HORA=6
PROCESSOVIVO_IA_PECAS_MAX_TOKENS=2500
PROCESSOVIVO_IA_PECAS_TIMEOUT_MS=120000
# Dias em que o resultado (com citações curtas, nunca o texto da peça) fica guardado.
PROCESSOVIVO_IA_PECAS_RESULTADO_DIAS=30
PROCESSOVIVO_IA_RESUMO_MAX_POR_HORA=6
PROCESSOVIVO_IA_RESUMO_MAX_TOKENS=1500
PROCESSOVIVO_IA_RESUMO_TIMEOUT_MS=120000

# === Google Drive (v0.42.0) ================================================
# Salvar as peças da Pasta digital no Google Drive do advogado, por botão.
# Resumo diário por e-mail dos eventos do calendário que esperam confirmação (v0.51.0).
# NASCE DESLIGADO: ligue só depois do deploy e de conferir com `npm run cli -- calendario resumo-previa`.
# Só envia com SMTP de verdade (SMTP_HOST e SMTP_FROM): sem eles não há entrega e o serviço nem é montado.
# Um e-mail por conta, no máximo um por dia, entre 08:00 e 12:00 (São Paulo), só com evento novo.
# Cada conta pode desligar em Calendário > Resumo por e-mail. Os lembretes (VALARM) do feed NÃO dependem desta chave.
PROCESSOVIVO_CALENDARIO_RESUMO_HABILITADO=false

# NASCE DESLIGADO: o dono liga com PROCESSOVIVO_DRIVE_HABILITADO=true. Ligado, o arranque
# EXIGE as três variáveis abaixo, PROCESSOVIVO_URL_BASE (https) e PROCESSOVIVO_CREDENCIAL_CHAVE
# (a autorização do Google só é guardada cifrada, no mesmo cofre da senha do tribunal).
# O escopo é um só (`drive.file`: o sistema só enxerga a pasta que ele mesmo cria) e NÃO é
# configurável. Só contas com "Salvar no Google Drive" no plano (Peças e IA) usam.
# O endereço de retorno que se cadastra no Google Cloud é PROCESSOVIVO_URL_BASE + /v1/drive/retorno.
PROCESSOVIVO_DRIVE_HABILITADO=false
# Nomes nativos do Google (Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth).
# Obrigatórias SOMENTE com o Drive habilitado. Nunca vão para log, resposta ou mensagem de erro.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Teto GLOBAL de envios ao mesmo tempo (um por conta). Pausa entre uma peça e a seguinte (ms).
PROCESSOVIVO_DRIVE_MAX_SIMULTANEOS=2
PROCESSOVIVO_DRIVE_PAUSA_ENTRE_PECAS_MS=400

# === Cobrança recorrente pelo Mercado Pago (v0.44.0) ========================
# Assinatura recorrente por CARTÃO, cobrada pelo Mercado Pago a cada ciclo. O sistema NUNCA recebe nem
# guarda dado de cartão: o comprador paga na página do Mercado Pago.
# NASCE DESLIGADA: o dono liga com PROCESSOVIVO_PAGAMENTO_HABILITADO=true. Desligada, não existe rota
# de checkout e o webhook responde 404. Ligada, o arranque EXIGE as duas credenciais abaixo e
# PROCESSOVIVO_URL_BASE em https (é dela que saem o retorno do checkout e o endereço do aviso).
PROCESSOVIVO_PAGAMENTO_HABILITADO=false
# `mercadopago` (padrão) ou `falso` (só desenvolvimento: não sobe em produção).
PROCESSOVIVO_PAGAMENTO_GATEWAY=mercadopago
# Ambiente do gateway: `teste` ou `producao`. OBRIGATÓRIA com a cobrança habilitada e SEM padrão (vazia,
# o serviço não sobe). O prefixo do token não diz o ambiente: o Mercado Pago emite credencial de teste
# com APP_USR-. Token TEST- com `producao` também não sobe.
PROCESSOVIVO_PAGAMENTO_AMBIENTE=
# Mercado Pago > Suas integrações > a aplicação. Obrigatórias SOMENTE com a cobrança habilitada. Nunca vão para log, resposta ou erro.
MERCADOPAGO_ACCESS_TOKEN=
# Gerada no painel ao salvar a configuração de Webhooks (Suas integrações > Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=
# Ambiente `teste` em servidor de PRODUÇÃO é recusado, a não ser que isto seja `true` (proposital).
PROCESSOVIVO_PAGAMENTO_PERMITIR_TESTE=false
# Quem recebe o aviso de estorno e de contestação (o sistema NÃO revoga o acesso sozinho). Vazio = só log.
PROCESSOVIVO_PAGAMENTO_AVISO_EMAIL=
# Endereço dos Termos de Uso, que a tela de assinatura linka. Vazio = o texto sai sem link.
PROCESSOVIVO_TERMOS_URL=
# Versão dos Termos de Uso que a pessoa aceita ANTES de pagar; o aceite grava essa versão. OBRIGATÓRIA com a
# cobrança habilitada (sem ela o serviço não sobe). Em produção: 1.1; passa a 1.2 quando os novos Termos saírem.
PROCESSOVIVO_TERMOS_VERSAO=

# --- Página de vendas (v0.45.0) -------------------------------------------------------------------------------
# A ORIGEM do site de vendas (https, sem caminho, sem barra no final), a única que o CORS de GET /v1/planos libera.
# Vazio = sem CORS nenhum. Nunca `*`. Não abre o resto da API (para isso existe CORS_ORIGINS, que é global).
PROCESSOVIVO_SITE_URL=
